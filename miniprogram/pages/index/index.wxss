/* ========== 提醒列表 ========== */
.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 40rpx;
}

.r-card {
  background: rgba(255,255,255,0.65);
  border: 1rpx solid rgba(255,255,255,0.7);
  border-radius: var(--radius-xl);
  padding: 32rpx 28rpx;
  box-shadow: var(--glass-shadow);
}

/* 头部 */
.r-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.r-tag {
  font-size: 22rpx;
}

.r-actions {
  display: flex;
  align-items: center;
}

.r-action-del {
  font-size: 24rpx;
  color: var(--text-tertiary);
  padding: 8rpx 16rpx;
}

.r-action-del:active {
  color: var(--red);
}

/* 标题 */
.r-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.35;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 备注 */
.r-note {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  margin-bottom: 12rpx;
}

/* 定期规则 */
.r-rule {
  display: block;
  font-size: 24rpx;
  color: var(--accent);
  margin-bottom: 12rpx;
  font-weight: 500;
}

/* 倒计时 */
.r-countdown {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  background: rgba(0,0,0,0.02);
  border-radius: var(--radius-md);
  margin-bottom: 12rpx;
}

.r-countdown-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.r-countdown-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent);
  font-variant-numeric: tabular-nums;
}

.r-expired-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--green);
}

/* 时间 */
.r-time {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.empty-glass {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-xl);
  padding: 80rpx 60rpx;
  box-shadow: var(--glass-shadow);
  width: 100%;
}

.empty-bell {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255,149,0,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.bell-icon {
  font-size: 72rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-bottom: 48rpx;
}

.empty-btn {
  width: 360rpx;
}
