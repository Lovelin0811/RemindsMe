/* ========== 统计卡片 ========== */
.stats-glass {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.65);
  border: 1rpx solid rgba(255,255,255,0.7);
  border-radius: var(--radius-xl);
  padding: 32rpx 20rpx;
  box-shadow: var(--glass-shadow-lg);
  margin-bottom: 36rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.stat-pending { color: var(--orange); }
.stat-done { color: var(--green); }

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  font-weight: 500;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(60,60,67,0.08);
}

/* ========== 筛选 Pill ========== */
.filter-row {
  display: flex;
  gap: 12rpx;
  padding: 0 4rpx;
  margin-bottom: 32rpx;
}

.filter-chip {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  background: rgba(255,255,255,0.4);
  border: 1rpx solid rgba(255,255,255,0.4);
  transition: all 0.2s ease;
}

.filter-chip.active {
  background: rgba(255,255,255,0.85);
  color: var(--text-primary);
  font-weight: 600;
  border-color: rgba(255,255,255,0.8);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* ========== 提醒列表 ========== */
.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.reminder-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 24rpx 16rpx 24rpx 24rpx;
  box-shadow: var(--glass-shadow);
  transition: opacity 0.2s ease;
}

.reminder-card.completed {
  opacity: 0.5;
}

.card-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 20rpx;
}

.check-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2.5rpx solid rgba(60,60,67,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
  font-size: 24rpx;
  color: #fff;
}

.check-circle.checked {
  background: var(--green);
  border-color: var(--green);
}

.card-body {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.card-title.done {
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.card-meta {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
  gap: 8rpx;
}

.card-time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.meta-dot {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.card-interval {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.card-tag {
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 4rpx;
}

.card-action {
  padding: 16rpx;
  flex-shrink: 0;
  margin-left: 4rpx;
}

.action-icon {
  font-size: 36rpx;
  color: var(--text-tertiary);
  font-weight: 300;
  line-height: 1;
}

/* ========== 列表空状态 ========== */
.list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.list-empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-bottom: 16rpx;
}

.list-empty-action {
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 500;
}
