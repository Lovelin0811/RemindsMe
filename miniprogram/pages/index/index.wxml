<wxs module="utils">
var pad = function(n) {
  return n < 10 ? '0' + n : '' + n
}

module.exports = {
  formatTime: function(timestamp) {
    if (!timestamp) return ''
    var d = getDate(timestamp)
    return pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes())
  }
}
</wxs>

<view class="page-wrap">
  <!-- 列表 -->
  <view class="reminder-list" wx:if="{{reminders.length > 0}}">
    <block wx:for="{{reminders}}" wx:key="id">
      <view class="r-card">
        <!-- 顶部：类型 + 操作 -->
        <view class="r-header">
          <view class="r-tag tag-pill tag-{{item.type}}">{{item.typeLabel}}</view>
          <view class="r-actions">
            <text class="r-action-del" catchtap="deleteReminder" data-id="{{item.id}}">删除</text>
          </view>
        </view>

        <!-- 标题 -->
        <text class="r-title">{{item.title}}</text>

        <!-- 备注 -->
        <text class="r-note" wx:if="{{item.note}}">{{item.note}}</text>

        <!-- 定期显示规则 -->
        <text class="r-rule" wx:if="{{item.type === 'repeat'}}">{{item.intervalLabel}}</text>

        <!-- 倒计时 / 已到期 -->
        <view class="r-countdown">
          <block wx:if="{{item.expired}}">
            <text class="r-expired-text">已到提醒时间</text>
          </block>
          <block wx:else>
            <text class="r-countdown-label">剩余</text>
            <text class="r-countdown-num">{{item.countdown}}</text>
          </block>
        </view>

        <!-- 时间 -->
        <text class="r-time">{{utils.formatTime(item.reminderTime)}}</text>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <view class="empty-glass">
      <view class="empty-bell">
        <text class="bell-icon">🔔</text>
      </view>
      <text class="empty-title">暂无待办提醒</text>
      <text class="empty-desc">点击创建，开启你的提醒</text>
      <button class="btn-pill empty-btn" bindtap="goAdd">创建提醒</button>
    </view>
  </view>
</view>
