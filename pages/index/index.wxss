/* ========== 下一个提醒 ========== */
.next-card {
  background: rgba(255,255,255,0.65);
  border: 1rpx solid rgba(255,255,255,0.7);
  border-radius: var(--radius-xl);
  padding: 40rpx 36rpx;
  box-shadow: var(--glass-shadow-lg);
  margin-bottom: 40rpx;
}

.next-tag {
  display: inline-flex;
  margin-bottom: 12rpx;
}

.next-subtitle {
  margin-bottom: 20rpx;
}

.next-sub-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

.next-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
  letter-spacing: -0.5rpx;
  margin-bottom: 16rpx;
}

.next-note {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.next-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: rgba(0,0,0,0.02);
  border-radius: var(--radius-md);
  margin-bottom: 32rpx;
}

.next-date {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-right: 16rpx;
}

.next-hour {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.next-time-block {
  display: flex;
  align-items: baseline;
}

/* ========== 倒计时 ========== */
.countdown-ring {
  text-align: center;
  padding: 20rpx 0 8rpx;
}

.countdown-num {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--accent);
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
}

/* ========== 操作按钮 ========== */
.action-row {
  display: flex;
  gap: 20rpx;
  padding: 0 12rpx;
}

.action-btn {
  flex: 1;
}

.action-done {
  background: var(--green);
  box-shadow: 0 4rpx 16rpx rgba(52,199,89,0.25);
}

.action-del {
  color: var(--red);
  background: rgba(255,59,48,0.06);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.empty-glass {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-xl);
  padding: 80rpx 60rpx;
  box-shadow: var(--glass-shadow);
  width: 100%;
}

.empty-bell {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255,149,0,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.bell-icon {
  font-size: 72rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-bottom: 48rpx;
}

.empty-btn {
  width: 360rpx;
}
