/**app.wxss - iOS 26 Liquid Glass Design System**/

/* ========== 全局变量 ========== */
page {
  --bg: #f2f0f5;
  --glass-bg: rgba(255,255,255,0.55);
  --glass-border: rgba(255,255,255,0.6);
  --glass-shadow: 0 2rpx 32rpx rgba(0,0,0,0.04), 0 0 1rpx rgba(0,0,0,0.08);
  --glass-shadow-lg: 0 8rpx 48rpx rgba(0,0,0,0.06), 0 0 1rpx rgba(0,0,0,0.08);
  --text-primary: #1c1c1e;
  --text-secondary: rgba(60,60,67,0.6);
  --text-tertiary: rgba(60,60,67,0.3);
  --accent: #007aff;
  --accent-light: rgba(0,122,255,0.1);
  --green: #34c759;
  --orange: #ff9500;
  --purple: #af52de;
  --red: #ff3b30;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 44rpx;

  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* ========== 通用玻璃卡片 ========== */
.glass {
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--glass-shadow);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
}

.glass-elevated {
  background: rgba(255,255,255,0.75);
  border: 1rpx solid rgba(255,255,255,0.8);
  border-radius: var(--radius-xl);
  box-shadow: var(--glass-shadow-lg);
}

/* ========== 页面容器 ========== */
.page-wrap {
  padding: 32rpx 28rpx;
  padding-bottom: 200rpx;
  min-height: 100vh;
}

/* ========== 页面标题区 ========== */
.section-header {
  margin: 8rpx 0 20rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* ========== iOS 风格 pill 按钮 ========== */
.btn-pill {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,122,255,0.25);
}

.btn-pill::after {
  border: none;
}

.btn-pill-secondary {
  background: rgba(0,122,255,0.08);
  color: var(--accent);
  border: none;
  border-radius: 999rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: none;
}

.btn-pill-secondary::after {
  border: none;
}

/* ========== 输入框玻璃风格 ========== */
.glass-input {
  background: rgba(255,255,255,0.45);
  border: 1rpx solid rgba(255,255,255,0.5);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  font-size: 32rpx;
  color: var(--text-primary);
}

.glass-input-placeholder {
  color: var(--text-tertiary);
}

/* ========== 标签 pill ========== */
.tag-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-delay { background: rgba(255,149,0,0.12); color: #c67c00; }
.tag-schedule { background: rgba(0,122,255,0.12); color: #005ec4; }
.tag-repeat { background: rgba(175,82,222,0.12); color: #8944ab; }
