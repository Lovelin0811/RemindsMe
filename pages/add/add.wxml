<view class="page-wrap">
  <!-- 类型选择器 - iOS Segmented Control 风格 -->
  <view class="segment-control">
    <view class="segment {{type === 'delay' ? 'active' : ''}}" bindtap="switchType" data-type="delay">
      <text class="segment-icon">⏱</text>
      <text class="segment-text">延时</text>
    </view>
    <view class="segment {{type === 'schedule' ? 'active' : ''}}" bindtap="switchType" data-type="schedule">
      <text class="segment-icon">📅</text>
      <text class="segment-text">指定时间</text>
    </view>
    <view class="segment {{type === 'repeat' ? 'active' : ''}}" bindtap="switchType" data-type="repeat">
      <text class="segment-icon">🔁</text>
      <text class="segment-text">定期</text>
    </view>
  </view>

  <!-- 内容输入 -->
  <view class="glass-card">
    <view class="field">
      <input class="field-input" placeholder="输入提醒内容" placeholder-class="placeholder" bindinput="onTitleInput" value="{{title}}" />
    </view>
  </view>

  <!-- ====== 延时选项 ====== -->
  <block wx:if="{{type === 'delay'}}">
    <view class="option-grid">
      <view class="option-chip {{delayIndex === idx ? 'selected' : ''}}" wx:for="{{delayOptions}}" wx:key="value" data-idx="{{idx}}" bindtap="onDelayTap">
        <text class="chip-text">{{item.label}}</text>
      </view>
    </view>
  </block>

  <!-- ====== 指定时间 ====== -->
  <block wx:if="{{type === 'schedule'}}">
    <view class="glass-card">
      <picker mode="date" value="{{scheduleDate}}" start="2026-01-01" bindchange="onScheduleDateChange">
        <view class="field-row">
          <text class="field-label">日期</text>
          <view class="field-value-wrap">
            <text class="field-value">{{scheduleDate}}</text>
            <text class="field-arrow">chevron_right</text>
          </view>
        </view>
      </picker>
      <view class="field-divider"></view>
      <picker mode="time" value="{{scheduleTime}}" bindchange="onScheduleTimeChange">
        <view class="field-row">
          <text class="field-label">时间</text>
          <view class="field-value-wrap">
            <text class="field-value">{{scheduleTime}}</text>
            <text class="field-arrow">chevron_right</text>
          </view>
        </view>
      </picker>
    </view>
  </block>

  <!-- ====== 定期提醒 ====== -->
  <block wx:if="{{type === 'repeat'}}">
    <view class="option-row">
      <view class="repeat-chip {{repeatRule === item.value ? 'selected' : ''}}" wx:for="{{repeatOptions}}" wx:key="value" data-rule="{{item.value}}" data-idx="{{index}}" bindtap="onRepeatTap">
        <text class="repeat-text">{{item.label}}</text>
      </view>
    </view>

    <!-- 每周选星期 -->
    <view class="weekday-row" wx:if="{{repeatRule === 'weekly'}}">
      <view class="weekday-chip {{repeatWeekday === idx ? 'selected' : ''}}" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this" data-wd="{{idx}}" bindtap="onWeekdayTap">
        <text class="weekday-text">{{item}}</text>
      </view>
    </view>

    <view class="glass-card" style="margin-top:32rpx">
      <picker mode="time" value="{{repeatTime}}" bindchange="onRepeatTimeChange">
        <view class="field-row">
          <text class="field-label">提醒时间</text>
          <view class="field-value-wrap">
            <text class="field-value">{{repeatTime}}</text>
            <text class="field-arrow">chevron_right</text>
          </view>
        </view>
      </picker>
    </view>
  </block>

  <!-- 备注 -->
  <view class="glass-card" style="margin-top:20rpx">
    <view class="field">
      <textarea class="field-textarea" placeholder="备注（可选）" placeholder-class="placeholder" bindinput="onNoteInput" value="{{note}}" maxlength="200" />
    </view>
  </view>

  <!-- 预览玻璃卡片 -->
  <view class="preview-glass" wx:if="{{reminderTimeDisplay}}">
    <view class="preview-dot"></view>
    <view class="preview-content">
      <text class="preview-label">预计提醒</text>
      <text class="preview-text">{{reminderTimeDisplay}}</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button class="btn-pill btn-fixed" bindtap="saveReminder">创建提醒</button>
</view>
