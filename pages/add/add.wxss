.page-wrap {
  padding: 32rpx 28rpx;
  padding-bottom: 200rpx;
  min-height: 100vh;
}

.placeholder {
  color: var(--text-tertiary);
  font-size: 30rpx;
  font-weight: 400;
}

/* ========== Segmented Control ========== */
.segment-control {
  display: flex;
  background: rgba(255,255,255,0.4);
  border: 1rpx solid rgba(255,255,255,0.5);
  border-radius: var(--radius-lg);
  padding: 6rpx;
  margin-bottom: 36rpx;
}

.segment {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: var(--radius-md);
  transition: all 0.25s ease;
}

.segment.active {
  background: rgba(255,255,255,0.85);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.segment-icon {
  font-size: 28rpx;
}

.segment-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.segment.active .segment-text {
  color: var(--text-primary);
  font-weight: 600;
}

/* ========== Glass Card ========== */
.glass-card {
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--glass-shadow);
  overflow: hidden;
  margin-bottom: 32rpx;
}

.field {
  padding: 8rpx 28rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  background: transparent;
}

.field-textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  background: transparent;
  line-height: 1.6;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.field-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.field-value-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.field-value {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.field-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-family: 'SF Pro Text', -apple-system, sans-serif;
}

.field-divider {
  height: 1rpx;
  background: rgba(60,60,67,0.06);
  margin: 0 28rpx;
}

/* ========== 延时选项 Grid ========== */
.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.option-chip {
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.45);
  border: 1rpx solid rgba(255,255,255,0.5);
  transition: all 0.2s ease;
}

.option-chip.selected {
  background: rgba(0,122,255,0.12);
  border-color: rgba(0,122,255,0.3);
  box-shadow: 0 2rpx 12rpx rgba(0,122,255,0.1);
}

.chip-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.option-chip.selected .chip-text {
  color: var(--accent);
  font-weight: 600;
}

/* ========== 定期选项 Row ========== */
.option-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}

.repeat-chip {
  padding: 20rpx 32rpx;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.45);
  border: 1rpx solid rgba(255,255,255,0.5);
  transition: all 0.2s ease;
}

.repeat-chip.selected {
  background: rgba(175,82,222,0.12);
  border-color: rgba(175,82,222,0.3);
}

.repeat-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.repeat-chip.selected .repeat-text {
  color: var(--purple);
  font-weight: 600;
}

/* ========== 星期选择 ========== */
.weekday-row {
  display: flex;
  gap: 12rpx;
  margin: 28rpx 0;
  justify-content: center;
}

.weekday-chip {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.45);
  border: 1rpx solid rgba(255,255,255,0.5);
  transition: all 0.2s ease;
}

.weekday-chip.selected {
  background: var(--accent);
  border-color: var(--accent);
  box-shadow: 0 4rpx 16rpx rgba(0,122,255,0.25);
}

.weekday-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.weekday-chip.selected .weekday-text {
  color: #fff;
  font-weight: 600;
}

/* ========== 预览 ========== */
.preview-glass {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 36rpx;
  padding: 24rpx 28rpx;
  background: rgba(0,122,255,0.06);
  border: 1rpx solid rgba(0,122,255,0.12);
  border-radius: var(--radius-lg);
}

.preview-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
  box-shadow: 0 0 12rpx rgba(0,122,255,0.4);
}

.preview-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
}

.preview-text {
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 600;
  margin-top: 4rpx;
}

.preview-content {
  flex: 1;
}

/* ========== Fixed Button ========== */
.btn-fixed {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 160rpx;
  z-index: 100;
}
